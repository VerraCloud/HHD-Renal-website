# Copy this file to .env and fill in real values. Never commit .env.

# The Gmail address that will send contact-form emails.
GMAIL_USER=your-address@gmail.com

# A 16-character Gmail App Password (NOT your regular Gmail password).
# Requires 2-Step Verification to be enabled on the Gmail account:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The inbox that should receive contact-form submissions.
# Can be the same address as GMAIL_USER, or a different one.
CONTACT_TO_EMAIL=info@hhdrenal.com

# Optional. Defaults to 3000.
PORT=3000
